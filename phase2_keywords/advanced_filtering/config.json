  "filtering_settings": {
    "multi_ocr": {
      "require_both_engines": false,
      "min_text_length": 2,
      "confidence_threshold": 0.3
    },
    "quality_classifier": {
      "model": "MobileNetV2",
      "confidence_threshold": 0.1,
      "filter_categories": [
        "folder", "envelope", "CD_player", "desktop_computer", "laptop",
        "computer_keyboard", "computer_mouse", "remote_control", "cellular_telephone",
        "iPod", "digital_clock", "screen", "television", "radio",
        "spider_web", "chain_mail", "honeycomb", "jigsaw_puzzle", "crossword_puzzle",
        "maze", "prayer_rug", "quilt", "chain_saw", "slot_machine",
        "spotlight", "stage", "theater_curtain", "projector", "screen",
        "blackboard", "white_board", "bulletin_board", "magnetic_board",
        "menu", "dialog_box", "computer_screen", "monitor", "CRT_screen"
      ],
      "min_image_size": [50, 50],
      "max_aspect_ratio": 5.0,
      "min_aspect_ratio": 0.2,
      "min_std_deviation": 10.0,
      "min_color_range": 15.0
    },
    "language_verification": {
      "model": "fasttext",
      "confidence_threshold": 0.1,
      "min_text_length": 1
    }
  },
  "processing_settings": {
    "batch_size": 32,
    "max_workers": 4,
    "timeout_seconds": 30,
    "retry_attempts": 2
  },
  "phase1_integration": {
    "data_directories": {
      "phase1_raw": "phase1_foundation/data/raw_{language}",
      "phase1_processed": "phase1_foundation/data/processed_{language}",
      "phase2_filtered": "phase2_keywords/data/filtered_{language}"
    },
    "pipeline_sequence": [
      "keyword_loading",
      "image_scraping", 
      "phase1_ocr_filtering",
      "phase2_multi_ocr_fusion",
      "phase2_quality_classification",
      "phase2_language_verification"
    ],
    "auto_cleanup": {
      "remove_raw_after_processing": false,
      "remove_intermediate_files": true,
      "keep_failed_images_log": true
    }
  }
}