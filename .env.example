# VQA Dataset Project - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Google Images Scraping Configuration (API-Free)
# ============================================================================
# Maximum number of scroll attempts to load more images
GOOGLE_SCROLL_ATTEMPTS=10

# Delay range for scrolling (seconds)
GOOGLE_SCROLL_DELAY_MIN=2.0
GOOGLE_SCROLL_DELAY_MAX=4.0

# Anti-detection delays (seconds)
GOOGLE_MIN_DELAY=1.0
GOOGLE_MAX_DELAY=3.0

# Enable user agent rotation (true/false)
GOOGLE_USER_AGENT_ROTATION=true

# ============================================================================
# Scraping Configuration
# ============================================================================
# Number of requests per second (rate limiting)
REQUESTS_PER_SECOND=2.0

# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=5

# Default number of images per keyword
IMAGES_PER_KEYWORD=10

# Minimum image size (pixels)
MIN_IMAGE_SIZE=100

# Request timeout (seconds)
REQUEST_TIMEOUT=10

# ============================================================================
# Selenium Configuration
# ============================================================================
# Run Chrome in headless mode (true/false)
SELENIUM_HEADLESS=true

# Chrome window size
SELENIUM_WINDOW_WIDTH=1920
SELENIUM_WINDOW_HEIGHT=1080

# Page load timeout (seconds)
SELENIUM_PAGE_TIMEOUT=30

# ============================================================================
# OCR Configuration
# ============================================================================
# EasyOCR languages (comma-separated)
OCR_LANGUAGES=ar,en

# Use GPU for OCR (true/false)
OCR_USE_GPU=false

# OCR confidence threshold (0.0-1.0)
OCR_CONFIDENCE_THRESHOLD=0.5

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Write logs to file (true/false)
LOG_TO_FILE=true

# Log directory
LOG_DIRECTORY=logs

# Maximum log file size (bytes)
MAX_LOG_SIZE=10485760

# Number of log backup files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# Data Storage Configuration
# ============================================================================
# Base directory for data storage
DATA_DIRECTORY=data

# Base directory for output files
OUTPUT_DIRECTORY=output

# Temporary files directory
TEMP_DIRECTORY=temp

# Maximum images per directory
MAX_IMAGES_PER_DIR=1000

# ============================================================================
# Keyword Generation Configuration
# ============================================================================
# Maximum prefixes per seed keyword
MAX_PREFIXES_PER_SEED=6

# Maximum suffixes per seed keyword
MAX_SUFFIXES_PER_SEED=6

# Enable special keyword combinations (true/false)
ENABLE_SPECIAL_COMBINATIONS=true

# ============================================================================
# Development & Debug Configuration
# ============================================================================
# Enable debug mode (true/false)
DEBUG_MODE=false

# Enable verbose output (true/false)
VERBOSE_OUTPUT=false

# Save debug images (true/false)
SAVE_DEBUG_IMAGES=false

# ============================================================================
# WebDriver Configuration
# ============================================================================
# Path to ChromeDriver (optional - will auto-download if not specified)
# CHROMEDRIVER_PATH=/path/to/chromedriver

# Chrome browser executable path (optional)
# CHROME_BINARY_PATH=/path/to/chrome

# ============================================================================
# Optional: External Service APIs (Currently Not Used)
# ============================================================================
# Note: This project uses API-free scraping methods
# These are kept for potential future use

# Pinterest API (if available)
# PINTEREST_API_KEY=your_pinterest_api_key

# Bing Search API (if available)
# BING_SEARCH_API_KEY=your_bing_api_key

# Flickr API (if available)
# FLICKR_API_KEY=your_flickr_api_key

# ============================================================================
# Performance Tuning
# ============================================================================
# Image processing quality (1-100)
IMAGE_QUALITY=90

# Enable image compression (true/false)
ENABLE_IMAGE_COMPRESSION=true

# Maximum memory usage for image processing (MB)
MAX_MEMORY_USAGE=512

# ============================================================================
# Security Configuration
# ============================================================================
# User agent string for web requests
USER_AGENT=Mozilla/5.0 (VQA Dataset Scraper)

# Enable SSL verification (true/false) - keep true for production
VERIFY_SSL=true

# Request retry attempts
MAX_RETRY_ATTEMPTS=3

# Retry delay (seconds)
RETRY_DELAY=1.0

# ============================================================================
# Notes:
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique API keys for each environment
# 3. Regularly rotate your API keys
# 4. Monitor your API usage to avoid quota exceeded errors
# 5. Adjust rate limiting based on API provider limits
# 6. Test configuration changes in development first